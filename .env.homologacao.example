# Copie para .env.homologacao.local e preencha só nesta máquina.
# Esse arquivo não é carregado pelo Next.js. Os scripts de homologação o aplicam
# e fazem esses valores prevalecerem sobre .env.local.
# Não cole chaves do projeto oficial.

ORIENTA_TARGET=homologacao
ORIENTA_HOMOLOGACAO_PROJECT_REF=
ORIENTA_PRODUCTION_PROJECT_REF=
# Formato: https://<ref-de-20-caracteres>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# No pooler, o usuário precisa ser postgres.<ref>. O hostname compartilhado não identifica o projeto.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3003

# Só para npm run db:push:homologacao:
# ORIENTA_HOMOLOGACAO_CONFIRM=aplicar-homologacao:SEU-REF-DE-HOMOLOGACAO

# Opcional. Se vazio, os scripts usam a senha fictícia já usada pela jornada E2E.
# E2E_PASSWORD=
