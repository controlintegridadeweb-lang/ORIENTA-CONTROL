# =============================================================================
# Runtime da aplicação (local e Vercel)
# Na Vercel cadastre SOMENTE este bloco. NEXT_PUBLIC_APP_URL local aponta para
# localhost; em produção use a origem HTTPS canônica (PRODUCTION_BASE_URL).
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
HEALTHCHECK_SECRET=

# Opcional no runtime. Ou as duas, ou nenhuma.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# =============================================================================
# Só local / CI / scripts — NÃO cadastrar na Vercel
# O app em runtime usa Auth, REST/RPC e Storage por HTTPS. Sem conexão direta
# ao PostgreSQL. Estas chaves servem a CLI, backup, restore e smoke test.
# =============================================================================
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
RESTORE_DRILL_TARGET_DB_URL=
RESTORE_DRILL_CONFIRM_TARGET=

# Origem HTTPS de produção. Smoke test e `npm run check:vercel-env` usam este
# valor no lugar de NEXT_PUBLIC_APP_URL ao montar o conjunto da Vercel.
PRODUCTION_BASE_URL=
EXPECTED_COMMIT=
